# EKAM — Public Edition · standalone host settings

# Port the app listens on.
PORT=4173

# Where EKAM keeps its database and files (attachments, generated images).
# Default: a "data" folder inside the app folder. Point this at a folder on a
# PERSISTENT disk — if the disk is wiped, all EKAM accounts, keys and chats
# are wiped with it.
# DATA_DIR=./data
